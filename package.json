{
  "name": "mnemosyne",
  "version": "0.1.0",
  "description": "Persistent, human-like memory for LLM agents. File-based, local-first, agent-agnostic.",
  "license": "Apache-2.0",
  "author": "Juanma Orta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanmaorta/mnemosyne.git"
  },
  "homepage": "https://github.com/juanmaorta/mnemosyne#readme",
  "bugs": {
    "url": "https://github.com/juanmaorta/mnemosyne/issues"
  },
  "type": "module",
  "bin": {
    "mneme": "dist/bin/mneme.js",
    "mem": "dist/bin/mneme.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:cosine": "node scripts/calibrate-cosine.mjs",
    "bench:retrieval": "npm run build && node scripts/calibrate-retrieval.mjs",
    "bench:golden": "npm run build && node scripts/bench-golden.mjs",
    "migrate": "tsc && node dist/bin/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9",
    "ulid": "^2.3.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
